APP_NAME="AajchaOffer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=city_pulses
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@aajchaoffer.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe
STRIPE_SECRET_KEY=
STRIPE_ENDPOINT_SECRET=
WEBHOOK_ALLOW_DEMO=0
WEBHOOK_DEMO_SECRET=

# Metals API
METALS_WASTAGE_PERCENT=0.5
METALS_MAKING_TYPE=fixed
METALS_MAKING_PER_10G=800
METALS_MAKING_PERCENT=2.0
METALS_DEALER_PREMIUM_PERCENT=0
METALS_GST_PERCENT=3.0
METALS_ROUND_NEAREST=10
METALS_MARKUP_PERCENT=0
METALS_TAX_PERCENT=0

# External APIs
ENABLE_TRANSLATION=0
NEWS_API_KEY=
WEATHER_API_KEY=
AGMARKNET_API_KEY=

# Admin
SUPERADMIN_EMAIL=admin@aajchaoffer.com

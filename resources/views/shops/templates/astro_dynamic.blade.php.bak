<footer><div class="footer-top"><div><div class="footer-brand">✨ {{ $brandName }}</div><div style="font-style:italic;color:rgba(240,220,160,.45)">{{ $heroTagline }}</div><div style="font-size:13px;color:rgba(240,220,160,.38);line-height:1.7">{{ $heroDescription }}</div></div><div class="footer-col"><h4>Services</h4>@foreach(array_slice($allItems,0,5) as $item)<a onclick="openModal('{{ e($item['name']) }}','{{ e($item['icon']) }}','{{ e($item['description']) }}','{{ e($item['name']) }}')">{{ $item['name'] }}</a>@endforeach</div><div class="footer-col"><h4>Quick Links</h4><a onclick="scrollToSection('hero')">Home</a><a onclick="scrollToSection('products')">Products</a><a onclick="scrollToSection('testimonials')">Reviews</a><a onclick="scrollToSection('contact')">Contact</a></div><div class="footer-col"><h4>Provider</h4><a>{{ $providerName }}</a>@if($providerContact !== '')<a>{{ $providerContact }}</a>@endif @if($providerEmail !== '')<a>{{ $providerEmail }}</a>@endif</div></div><div style="padding-top:24px;border-top:1px solid rgba(245,197,24,.07);font-size:12px;color:rgba(240,220,160,.28)">© {{ now()->year }} {{ $brandName }} · All Rights Reserved</div></footer>
<div class="modal-overlay" id="modalOverlay" onclick="closeModalOutside(event)"><div class="modal" id="modal"><button class="modal-close" onclick="closeModal()">✕</button><span id="modalBadge" style="font-size:30px;display:block;text-align:center;margin-bottom:12px">🔮</span><h2 id="modalTitle" style="font-family:'Cinzel',serif;color:var(--gold);margin-bottom:8px;text-align:center">Book a Consultation</h2><p id="modalSub" style="font-size:13px;color:var(--muted);text-align:center;margin-bottom:20px"></p><div class="form-field"><label>Your Name</label><input type="text" id="m-name" placeholder="Full name"/></div><div class="form-field"><label>Phone Number</label><input type="tel" id="m-phone" placeholder="+91 XXXXX XXXXX"/></div><div class="form-field"><label>Service</label><input type="text" id="m-service"/></div><div class="form-field"><label>Your Question</label><textarea id="m-msg" style="min-height:80px"></textarea></div><button class="modal-submit" onclick="submitModal()">✦ Book Consultation Now</button></div></div>
<div class="toast" id="toast"></div>
<a class="wa-float" onclick="openWhatsApp()" title="WhatsApp"><svg viewBox="0 0 24 24" width="28" height="28" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg></a>
<button class="back-top" id="backTop" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>
<script>
(function(){const c=document.getElementById('starCanvas');const ctx=c.getContext('2d');let stars=[];function resize(){c.width=window.innerWidth;c.height=window.innerHeight;init()}function init(){stars=[];const n=Math.floor((c.width*c.height)/4000);for(let i=0;i<n;i++){stars.push({x:Math.random()*c.width,y:Math.random()*c.height,r:Math.random()*1.2+.2,o:Math.random()*.8+.1,s:Math.random()*.015+.003,d:Math.random()>0.5?1:-1})}}function draw(){ctx.clearRect(0,0,c.width,c.height);stars.forEach(s=>{s.o+=s.s*s.d;if(s.o>1||s.o<.05)s.d*=-1;ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fillStyle=`rgba(245,197,24,${s.o})`;ctx.fill()});requestAnimationFrame(draw)}window.addEventListener('resize',resize);resize();draw();})();
const ASTROLOGY=@json($astrologyItems); const SERVICES=@json(count($serviceItems) ? $serviceItems : $astrologyItems); const PRODUCTS=[{ico:'💎',name:'Gemstone / Rashi Ratna',description:'Certified natural gemstones prescribed as per your chart.',badge:'Lab Certified'},{ico:'🏡',name:'Vastu Products',description:'Yantra, pyramids, crystals and sacred vastu items.',badge:'Energised'},{ico:'🛠️',name:'Vastu Tools',description:'Professional vastu tools and divination instruments.',badge:'Professional Grade'}];
function buildGrid(data,containerId){const el=document.getElementById(containerId);el.innerHTML=data.map(item=>`<div class="svc-card reveal" onclick="openModal('${(item.name||'').replace(/'/g,"\\'")}','${(item.icon||'✨').replace(/'/g,"\\'")}','${(item.description||'').replace(/'/g,"\\'")}','${(item.name||'').replace(/'/g,"\\'")}')"><span class="ico">${item.icon||'✨'}</span><h3>${item.name||''}</h3><p>${item.description||''}</p><div class="prod-badge" style="margin-top:10px">${item.price||'From ₹499'}</div></div>`).join('');}
function buildProducts(){const el=document.getElementById('productsGrid');el.innerHTML=PRODUCTS.map(p=>`<div class="prod-card reveal" onclick="openModal('${p.name}','${p.ico}','${p.description}','${p.name}')"><span class="ico">${p.ico}</span><h3>${p.name}</h3><p>${p.description}</p><span class="prod-badge">${p.badge}</span><button class="btn-buy" style="margin-top:12px;width:100%">Order Now</button></div>`).join('');}
buildGrid(ASTROLOGY,'astrologyGrid');buildGrid(SERVICES,'servicesGrid');buildProducts();
const navbar=document.getElementById('navbar');const backTop=document.getElementById('backTop');window.addEventListener('scroll',()=>{navbar.classList.toggle('scrolled',window.scrollY>50);backTop.classList.toggle('show',window.scrollY>400);document.querySelectorAll('.reveal').forEach(el=>{const r=el.getBoundingClientRect();if(r.top<window.innerHeight-60)el.classList.add('visible');});},{passive:true});
function scrollToSection(id){const el=document.getElementById(id);if(el){const top=el.getBoundingClientRect().top+window.scrollY-70;window.scrollTo({top,behavior:'smooth'});}}
function toggleMenu(){const menu=document.getElementById('mobileMenu');const btn=document.getElementById('hamburger');const open=menu.classList.toggle('open');btn.classList.toggle('open',open);document.body.style.overflow=open?'hidden':'';}
function openModal(title,badge,sub,service){document.getElementById('modalTitle').textContent=title;document.getElementById('modalBadge').textContent=badge;document.getElementById('modalSub').textContent=sub;document.getElementById('m-service').value=service||title;document.getElementById('modalOverlay').classList.add('open');document.body.style.overflow='hidden';}
function closeModal(){document.getElementById('modalOverlay').classList.remove('open');document.body.style.overflow='';}
function closeModalOutside(e){if(e.target===document.getElementById('modalOverlay'))closeModal();}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();});
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000);} 
function submitModal(){const name=document.getElementById('m-name').value.trim();const phone=document.getElementById('m-phone').value.trim();if(!name||!phone){showToast('Please enter name and phone number');return;}closeModal();showToast('Booking confirmed! We will call you shortly.');}
function submitCTA(){const phone=document.getElementById('ctaPhone').value.trim();if(!phone){showToast('Please enter your phone number');return;}showToast('Thank you! We will call you shortly.');document.getElementById('ctaPhone').value='';}
function submitContactForm(){const name=document.getElementById('cf-name').value.trim();const phone=document.getElementById('cf-phone').value.trim();if(!name||!phone){showToast('Please enter name and phone number');return;}showToast('Booking request submitted! We will contact you shortly.');}
function openWhatsApp(){const base='{{ $providerContact !== '' ? preg_replace('/\D+/', '', $providerContact) : '919876543210' }}';window.open(`https://wa.me/${base}?text=Hello!%20I%20would%20like%20to%20book%20a%20consultation.`,'_blank');}
window.addEventListener('load',()=>{setTimeout(()=>{document.querySelectorAll('.reveal').forEach(el=>{const r=el.getBoundingClientRect();if(r.top<window.innerHeight-60)el.classList.add('visible');});},100);});
</script>
</body>
</html>
